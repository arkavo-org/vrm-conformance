# Rust
target/
Cargo.lock.bak
**/*.rs.bk

# Generated assets (built locally, distributed via S3 / GH releases)
assets/generated/
test-plans/generated/

# Local-bootstrap render cache (scripts/bootstrap-goldens.sh output).
# PNGs and intermediate assets live here; they're machine-specific and
# never belong in git. The canonical S3-backed manifest lives at
# goldens/manifest.json — that one is committed.
goldens-cache/

# Swift / Xcode (adapters/<adapter>/.build/ is also Swift)
adapters/*/.build/
adapters/*/.swiftpm/
adapters/*/Package.resolved

# Node (TS adapter projects under adapters/)
adapters/*/node_modules/
adapters/*/dist/
adapters/*/package-lock.json.bak
xcuserdata/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
.build/
Carthage/Build/

# Site
site/node_modules/
site/dist/
site/.vite/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local validator install (script writes here)
.tools/

# Smoke-test scratch output
.smoke/

# Local credentials
.env
.env.local

# Claude Code per-project runtime state (lockfiles, scheduled task records)
.claude/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Humanoid fixtures: symlinks to upstream-licensed VRM avatars
# (VRM Platform License 1.0). Materialized by scripts/install-humanoid-fixtures.sh.
assets/humanoid/

# Python bytecode cache (vrma-pose-consensus.py + future python helpers)
__pycache__/
*.pyc
